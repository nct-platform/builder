# test/.env.example — the keys the suite reads. `mrjun.py autotest scaffold` copies this file to test/.env
# (mode 600, git-ignored); the project's OWNER fills .env in. Never commit .env, never print it, never paste a
# value from it into a chat — the test process reads it, nobody else needs to. `mrjun.py autotest env` says which
# keys are set without showing a value. The keys of this file are read from .env ONLY — a shell variable of the
# same name is ignored — except the run's knobs (DEFAULT_LOCALE, HEADLESS, SLOW_MO_MS, the timeouts), which the
# shell may override for one run. This file itself never carries a value for a secret.

# ⛔ ALWAYS <root>/<realm>/<client> — the project's own address, e.g. https://<host>/<realm>/<client>.
#    The bare installation root bounces to …/auth;jsessionid=… and renders none of the project.
BASE_URL=

# One user holding the Author role group — the only group that can hand out role groups, so every other identity
# the scenarios need is built from this one, and the suite never removes Author from it. It must ALSO hold every
# role group whose tasks and actions the scenarios perform (the queues of a process are per role group), except the
# steps a persona below performs.
AUTH_USER=
AUTH_PASSWORD=

# The locale the suite returns to after the language tests — one of the project's locales.
DEFAULT_LOCALE=en_US

# Keep 1 for every long run: a visible window dies with a screen lock or a stray Cmd-W, and the run then fails
# with TargetClosedError, which reads like a crash. Watch one test with: HEADLESS=0 SLOW_MO_MS=250 ./start.sh -k <name>
HEADLESS=1
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=30000
GRID_TIMEOUT_MS=45000

# Optional — the database cross-check: calculation, ripple and write tests read the row back and compare it with the
# screen and with the scenario. Empty = those checks SKIP and say so. The source's host is often an internal name
# of the platform's network, so it may need a tunnel. The session is forced read-only by helpers/db.py.
# host=<host> port=5432 dbname=<db> user=<user> password=<secret> options=-csearch_path=<schema>
PGDSN=

# Optional — the public-API tests (doc 32 §9): a key the owner created in Settings → Developer → API and bound to
# the endpoints the handover lists. Empty = those tests SKIP with a reason that names it.
API_KEY=
# Optional — only when the API answers on another address than BASE_URL's installation root (a project served on a
# domain of its own): https://<platform-host>/public-api/v1. Empty = derived from BASE_URL.
API_BASE_URL=

# Optional — personas: a SECOND person, for the scenarios that must be performed by someone other than the author
# account (an approver who may not be the initiator, a clerk who must NOT see the admin console). The owner
# creates the user in the project, gives it the role groups the scenario names, and writes it here. Missing =
# those scenarios SKIP and name the persona they need. One pair per persona; <NAME> is the persona's name in
# test-scenarios.md, upper-case:
# PERSONA_APPROVER_USER=
# PERSONA_APPROVER_PASSWORD=
