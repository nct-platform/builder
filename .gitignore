HELP.md
.gradle
build/
# ...but a sales case's generators ARE the source of the export — the Gradle rule above would
# silently swallow doc/sales/<case>/build/**, which is the only place that project exists.
!doc/sales/**/build/
!doc/sales/**/build/**
log/
**/src/main/resources/logback-spring.xml
env/mac/local/data/
env/mac/local-new/data/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

